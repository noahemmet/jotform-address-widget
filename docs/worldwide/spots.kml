  <Placemark>
    <name>Sellwood Seed Swap Cabinet</name>
    <description><![CDATA[A repurposed medicine cabinet on the library's side lawn, full of labeled envelopes of vegetable and flower seeds. Leave what you have extra of, take what you'll plant.]]></description>
    <styleUrl>#cat-plant-and-seed-swaps</styleUrl>
    <ExtendedData>
      <Data name="neighborhood"><value>Sellwood</value></Data>
      <Data name="street"><value>7860 Southeast 13th Avenue</value></Data>
      <Data name="city"><value>Portland</value></Data>
      <Data name="state"><value>Oregon</value></Data>
      <Data name="postal"><value>97202</value></Data>
      <Data name="Category"><value>Plant and Seed Swaps</value></Data>
    </ExtendedData>
    <Point><coordinates>-122.6527888,45.4677335,0</coordinates></Point>
  </Placemark>
  <Placemark>
    <name>Alberta Street Mosaic Pillar</name>
    <description><![CDATA[Tiled mosaic column on the sidewalk outside the coffee shop, covered in broken plates and mirror shards. Different artist adds a panel each summer.]]></description>
    <styleUrl>#cat-art-installation</styleUrl>
